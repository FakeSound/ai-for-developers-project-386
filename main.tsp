import "@typespec/http";

using TypeSpec.Http;

/**
 * HTTP API сервиса бронирования встреч.
 *
 * В домене две роли:
 *
 * - **Владелец календаря** — единственный заранее заданный профиль (`Owner`).
 *   Создаёт типы событий и просматривает список предстоящих встреч.
 * - **Гость** — анонимный посетитель. Выбирает тип события, свободный слот
 *   в ближайшие 14 дней и создаёт бронирование.
 *
 * Регистрации, входа в систему и аккаунтов гостей нет: ни одна операция
 * не требует заголовков авторизации. Админская часть работает от профиля
 * владельца по умолчанию и отличается только маршрутами.
 *
 * Ключевые правила:
 *
 * - Слоты формируются на фиксированной сетке рабочего времени владельца
 *   (`Owner.workdays`, `Owner.workDayStart`, `Owner.workDayEnd`,
 *   `Owner.slotStepMinutes`). Настройка расписания через API не предусмотрена.
 * - Окно записи — `Owner.bookingWindowDays` (14) дней, начиная с текущей даты.
 * - На одно и то же время нельзя создать две записи, даже если это разные
 *   типы событий: занятость календаря глобальная.
 *
 * Все моменты времени передаются в UTC (ISO-8601). Часовой пояс владельца
 * отдаётся отдельным полем `Owner.timeZone`, чтобы клиент показал местное время.
 */
@service(#{ title: "AICalls Booking API" })
@server("http://localhost:3000/api/v1", "Локальный сервер разработки")
namespace AICalls;

// ---------------------------------------------------------------------------
// Доменные сущности
// ---------------------------------------------------------------------------

/** День недели. */
enum Weekday {
  monday,
  tuesday,
  wednesday,
  thursday,
  friday,
  saturday,
  sunday,
}

/** Время суток в формате `HH:mm` по часовому поясу владельца. */
@pattern("^([01][0-9]|2[0-3]):[0-5][0-9]$")
scalar TimeOfDay extends string;

/**
 * Владелец календаря — единственный заранее заданный профиль.
 *
 * Создаётся при развёртывании сервиса и через API не изменяется.
 * Помимо контактных данных описывает сетку, по которой строятся слоты.
 */
model Owner {
  /** Идентификатор профиля владельца. */
  id: string;

  /** Отображаемое имя, показывается гостю на странице бронирования. */
  @minLength(1)
  @maxLength(100)
  name: string;

  /** Контактный адрес владельца. */
  @format("email")
  email: string;

  /** Часовой пояс в формате IANA, например `Europe/Moscow`. */
  timeZone: string;

  /** Дни недели, в которые владелец принимает встречи. */
  workdays: Weekday[];

  /** Начало рабочего дня, например `10:00`. */
  workDayStart: TimeOfDay;

  /** Конец рабочего дня, например `18:00`. Последний слот заканчивается не позже этого времени. */
  workDayEnd: TimeOfDay;

  /** Шаг сетки слотов в минутах: начала слотов кратны этому значению от `workDayStart`. */
  @minValue(5)
  @maxValue(240)
  slotStepMinutes: int32;

  /** Глубина окна записи в днях, считая от текущей даты. По умолчанию 14. */
  @minValue(1)
  @maxValue(365)
  bookingWindowDays: int32;
}

/**
 * Тип события — вид встречи, который владелец предлагает гостям.
 *
 * Гость видит название, описание и длительность; длительность задаёт,
 * сколько времени занимает слот этого типа.
 */
model EventType {
  /** Идентификатор, который задаёт владелец при создании. Уникален в пределах сервиса. */
  @pattern("^[a-z0-9]+(-[a-z0-9]+)*$")
  @maxLength(64)
  id: string;

  /** Название, например «Знакомство». */
  @minLength(1)
  @maxLength(100)
  title: string;

  /** Описание для страницы с видами брони. */
  @maxLength(1000)
  description: string;

  /** Длительность встречи в минутах. */
  @minValue(5)
  @maxValue(480)
  durationMinutes: int32;

  /** Момент создания типа события. */
  createdAt: utcDateTime;
}

/** Данные для создания типа события. Поле `createdAt` заполняет сервер. */
model EventTypeCreate {
  /** Идентификатор задаёт владелец. Если такой уже существует — 409 `event_type_exists`. */
  @pattern("^[a-z0-9]+(-[a-z0-9]+)*$")
  @maxLength(64)
  id: string;

  @minLength(1)
  @maxLength(100)
  title: string;

  @maxLength(1000)
  description: string;

  @minValue(5)
  @maxValue(480)
  durationMinutes: int32;
}

/** Краткая карточка типа события внутри бронирования. */
model EventTypeSummary {
  id: string;
  title: string;
  durationMinutes: int32;
}

/**
 * Слот — отрезок времени на сетке владельца, доступный для записи.
 *
 * Слоты не хранятся как отдельные записи: сервер вычисляет их из рабочего
 * расписания владельца, длительности типа события и уже созданных броней.
 * В ответах перечисляются только свободные слоты.
 */
model Slot {
  /** Начало слота, UTC. Именно это значение гость отправляет при бронировании. */
  startsAt: utcDateTime;

  /** Конец слота: `startsAt` + `EventType.durationMinutes`. */
  endsAt: utcDateTime;
}

/** Свободные слоты одного календарного дня в часовом поясе владельца. */
model DaySlots {
  /** Дата в часовом поясе владельца. */
  date: plainDate;

  /** Свободные слоты этого дня. Пустой массив означает, что записаться нельзя. */
  slots: Slot[];
}

/** Календарь свободных слотов одного типа события за запрошенный диапазон дат. */
model SlotsPage {
  /** Тип события, для которого построен календарь. */
  eventTypeId: string;

  /** Длительность слота в минутах. */
  durationMinutes: int32;

  /** Часовой пояс владельца, в котором сгруппированы дни. */
  timeZone: string;

  /** Первый день диапазона включительно. */
  from: plainDate;

  /** Последний день диапазона включительно. */
  to: plainDate;

  /** Дни диапазона по возрастанию, включая дни без свободных слотов. */
  days: DaySlots[];
}

/** Гость — человек, который бронирует встречу. Аккаунт не создаётся. */
model Guest {
  /** Имя гостя. */
  @minLength(1)
  @maxLength(100)
  name: string;

  /** Email гостя для связи и подтверждения. */
  @format("email")
  email: string;
}

/**
 * Бронирование — занятый слот календаря.
 *
 * Бронирования всех типов событий живут в одном календаре: два бронирования
 * не могут пересекаться по времени, даже если относятся к разным типам.
 */
model Booking {
  /** Идентификатор бронирования, назначает сервер. */
  id: string;

  /** Тип события, на который создана запись. */
  eventType: EventTypeSummary;

  /** Начало встречи, UTC. */
  startsAt: utcDateTime;

  /** Конец встречи: `startsAt` + длительность типа события. Вычисляет сервер. */
  endsAt: utcDateTime;

  /** Кто записался. */
  guest: Guest;

  /** Комментарий гостя. */
  @maxLength(500)
  notes?: string;

  /** Момент создания записи. */
  createdAt: utcDateTime;
}

/** Данные для создания бронирования. */
model BookingCreate {
  /** Идентификатор выбранного типа события. */
  eventTypeId: string;

  /**
   * Начало выбранного слота, UTC. Должно совпадать с одним из значений
   * `Slot.startsAt`, полученных из календаря свободных слотов.
   */
  startsAt: utcDateTime;

  /** Имя и email гостя. */
  guest: Guest;

  /** Необязательный комментарий к встрече. */
  @maxLength(500)
  notes?: string;
}

// ---------------------------------------------------------------------------
// Ошибки
// ---------------------------------------------------------------------------

/** Машиночитаемая причина отказа. */
enum ErrorCode {
  /** Тело запроса или параметры не прошли валидацию. */
  validation_failed,

  /** Запрошенный ресурс не найден. */
  not_found,

  /** Тип события с таким `id` уже существует. */
  event_type_exists,

  /** На это время уже есть запись — возможно, другого типа события. */
  slot_taken,

  /** `startsAt` не совпадает с началом слота на сетке владельца. */
  slot_not_in_grid,

  /** Время выходит за окно записи в `Owner.bookingWindowDays` дней. */
  slot_out_of_window,
}

/** Тело ответа при ошибке. */
model ApiError {
  /** Код ошибки для обработки на клиенте. */
  code: ErrorCode;

  /** Человекочитаемое сообщение. */
  message: string;

  /** Дополнительный контекст, например список невалидных полей. */
  details?: Record<unknown>;
}

/** 400 — некорректный запрос. */
@error
model BadRequestError {
  @statusCode statusCode: 400;
  ...ApiError;
}

/** 404 — ресурс не найден. */
@error
model NotFoundError {
  @statusCode statusCode: 404;
  ...ApiError;
}

/** 409 — конфликт с текущим состоянием календаря. */
@error
model ConflictError {
  @statusCode statusCode: 409;
  ...ApiError;
}

/** 201 — ресурс создан. */
model CreatedResource<Resource> {
  @statusCode statusCode: 201;
  @body resource: Resource;
}

// ---------------------------------------------------------------------------
// Публичная часть: профиль владельца
// ---------------------------------------------------------------------------

@route("/owner")
@tag("Владелец")
interface OwnerProfile {
  /**
   * Профиль владельца календаря и правила формирования слотов.
   *
   * Используется публичной страницей бронирования (чей это календарь,
   * в каком часовом поясе показывать время) и админской частью,
   * которая работает от этого профиля по умолчанию.
   */
  @get
  read(): Owner;
}

// ---------------------------------------------------------------------------
// Типы событий и слоты
// ---------------------------------------------------------------------------

/**
 * Типы событий.
 *
 * Чтение доступно гостю (страница с видами брони), создание выполняет
 * владелец из админской части.
 */
@route("/event-types")
@tag("Типы событий")
interface EventTypes {
  /**
   * Список типов событий для страницы с видами брони.
   *
   * Шаг 1 публичного сценария гостя.
   */
  @get
  list(): EventType[];

  /**
   * Карточка одного типа события.
   *
   * Шаг 2 публичного сценария гостя: гость выбрал вид брони.
   */
  @route("/{id}")
  @get
  read(@path id: string): EventType | NotFoundError;

  /**
   * Создание типа события владельцем.
   *
   * Идентификатор задаёт сам владелец. Если тип с таким `id` уже есть,
   * возвращается 409 `event_type_exists`.
   */
  @post
  create(@body eventType: EventTypeCreate): CreatedResource<EventType> | BadRequestError | ConflictError;

  /**
   * Календарь свободных слотов выбранного типа события.
   *
   * Шаг 3 публичного сценария гостя. Слоты строятся по рабочему расписанию
   * владельца с шагом `Owner.slotStepMinutes`; слот попадает в ответ, только
   * если он полностью свободен — пересечения с бронированиями любых других
   * типов событий исключают слот из выдачи.
   *
   * Диапазон `from`–`to` должен целиком лежать в окне записи: от текущей даты
   * до текущей даты плюс `Owner.bookingWindowDays` (14) дней. По умолчанию
   * возвращается всё окно целиком. Диапазон вне окна — 400 `validation_failed`.
   */
  @route("/{id}/slots")
  @get
  listSlots(
    @path id: string,

    /** Первый день диапазона включительно. По умолчанию — текущая дата. */
    @query from?: plainDate,

    /** Последний день диапазона включительно. По умолчанию — текущая дата плюс 14 дней. */
    @query to?: plainDate,
  ): SlotsPage | BadRequestError | NotFoundError;
}

// ---------------------------------------------------------------------------
// Бронирования
// ---------------------------------------------------------------------------

@route("/bookings")
@tag("Бронирования")
interface Bookings {
  /**
   * Создание бронирования гостем.
   *
   * Шаг 4 публичного сценария гостя, завершающий: гость отправляет выбранный
   * слот, своё имя и email. Аккаунт при этом не создаётся.
   *
   * Проверки сервера:
   *
   * - тип события существует, иначе 404 `not_found`;
   * - `startsAt` совпадает с началом слота на сетке, иначе 409 `slot_not_in_grid`;
   * - `startsAt` лежит в окне записи на 14 дней, иначе 409 `slot_out_of_window`;
   * - время не пересекается с уже существующими бронированиями **любых** типов
   *   событий, иначе 409 `slot_taken`.
   *
   * Ответ 409 `slot_taken` означает, что слот заняли между шагами 3 и 4:
   * клиенту следует перезапросить календарь слотов и предложить другое время.
   */
  @post
  create(@body booking: BookingCreate): CreatedResource<Booking> | BadRequestError | NotFoundError | ConflictError;
}

// ---------------------------------------------------------------------------
// Админская часть
// ---------------------------------------------------------------------------

@route("/admin/bookings")
@tag("Админская часть")
interface AdminBookings {
  /**
   * Страница предстоящих встреч владельца.
   *
   * Один список бронирований всех типов событий, отсортированный
   * по `startsAt` по возрастанию. Каждая запись содержит краткую карточку
   * типа события, поэтому дозапросы не нужны.
   */
  @get
  list(
    /** Нижняя граница выборки включительно, UTC. По умолчанию — текущий момент. */
    @query from?: utcDateTime,

    /** Верхняя граница выборки исключительно, UTC. По умолчанию не ограничена. */
    @query to?: utcDateTime,
  ): Booking[] | BadRequestError;
}
