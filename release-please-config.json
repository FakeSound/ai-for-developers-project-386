{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "aicalls",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-component-in-tag": false,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "frontend/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "frontend/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "generic", "path": "backend/app/main.py" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Новое" },
        { "type": "fix", "section": "Исправления" },
        { "type": "perf", "section": "Производительность" },
        { "type": "revert", "section": "Откаты" },
        { "type": "docs", "section": "Документация" },
        { "type": "refactor", "section": "Переработка кода" },
        { "type": "build", "section": "Сборка и зависимости" },
        { "type": "test", "section": "Тесты", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "style", "section": "Оформление кода", "hidden": true },
        { "type": "chore", "section": "Прочее", "hidden": true }
      ]
    }
  }
}
